                >
                   confirm 
                </button>
              </app-button>
              <app-button
                class="*:rounded-l-none"
              >
                <button
                  class="btn primary"
                >
                   cancel 
                </button>
              </app-button>
            </div>
          </app-stack>
        </div>
      </section>
    </app-dialog-layout>
    <!--container-->
    <!--container-->
  </dialog>
</div>
`;
